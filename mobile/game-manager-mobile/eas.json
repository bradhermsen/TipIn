{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "dev",
        "EXPO_PUBLIC_API_BASE": "https://api-dev.tipinscoring.com/api"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "dev",
        "EXPO_PUBLIC_API_BASE": "https://api-dev.tipinscoring.com/api"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_BASE": "https://func-tipin-api-prod-cus-01.azurewebsites.net/api"
      }
    }
  }
}
